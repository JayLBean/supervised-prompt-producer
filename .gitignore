# spp project artifacts (per-task user state, not the skill itself).
# These are ephemeral run outputs that should not be committed; the durable
# artifacts (plan.md, REPORT.md, PROMPT_FROZEN_*.md, splits.json,
# baseline.csv) remain tracked because they are the methodology's outputs.
spp/*/runs/*/results.json
spp/*/runs/*/test_results.json
spp/*/runs/*/eval.json
spp/*/_dryrun/
spp/*/runs/*/_dryrun/
